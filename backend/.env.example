# ---------------------------------------------
# CareClaim AI — Backend environment
# Copy to .env and fill in real values.
# NEVER commit .env or expose these to the frontend.
# ---------------------------------------------
PORT=5000
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GEMINI_API_KEY=your_gemini_api_key

# Optional
# Gemini 1.5 models are retired; default is gemini-2.5-flash. Override if needed.
GEMINI_MODEL=gemini-2.5-flash
# Asked when GEMINI_MODEL answers "quota exhausted" (default gemini-3.5-flash-lite). Set it empty for no fallback.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Cap on model requests (adjudications and bill scans) per account per day. Unset or 0 = no cap.
# AI_DAILY_LIMIT_PER_USER=
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# When set, an account can only be set up as a hospital by entering this code.
# Leave unset and anyone who registers can choose "hospital".
# HOSPITAL_ACCESS_CODE=
